# Dextar++ Website - Variáveis de Ambiente (.env)

# Configurações do Servidor Node / Docker
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# URL do site em Produção (Usada para Canonical URLs e Meta Tags de SEO)
NEXT_PUBLIC_SITE_URL=https://dextar.com.br

# Desativar telemetria do Next.js
NEXT_TELEMETRY_DISABLED=1

# Opcional: Integração de Formulário de Contato / CRM (Ex: Resend, SendGrid ou Webhook)
# CONTACT_FORM_WEBHOOK_URL=https://api.dextar.com.br/v1/leads
# RESEND_API_KEY=re_123456789

# Opcional: Analytics (Ex: Google Tag Manager / GA4)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
